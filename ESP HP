-- Refresh List Logic
local function refreshMonitor()
    for _, child in pairs(Scroll:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
    listItems = {}
    local canvasY = 0
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local isFriend = LocalPlayer:IsFriendsWith(p.UserId)
        local item = Instance.new("Frame", Scroll)
        item.Size = UDim2.new(1, -5, 0, 40); item.BackgroundColor3 = Color3.fromRGB(30,30,30); item.BackgroundTransparency = 0.5
        Instance.new("UICorner", item).CornerRadius = UDim.new(0, 6)
        
        local nameLabel = Instance.new("TextLabel", item)
        nameLabel.Size = UDim2.new(1, -10, 0, 20); nameLabel.Position = UDim2.new(0, 8, 0, 2); nameLabel.BackgroundTransparency = 1
        nameLabel.Text = (isFriend and "⭐ " or "") .. p.Name
        nameLabel.TextColor3 = isFriend and Config.Cyan or Config.White; nameLabel.Font = Enum.Font.GothamBold; nameLabel.TextSize = 11; nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        
        local hpLabel = Instance.new("TextLabel", item)
        hpLabel.Size = UDim2.new(1, -10, 0, 15); hpLabel.Position = UDim2.new(0, 8, 0, 20); hpLabel.BackgroundTransparency = 1
        hpLabel.Text = "HP: 100"; hpLabel.TextColor3 = Config.Red; hpLabel.Font = Enum.Font.Gotham; hpLabel.TextSize = 10; hpLabel.TextXAlignment = Enum.TextXAlignment.Left
        
        listItems[p] = hpLabel
        canvasY = canvasY + 45
    end
    Scroll.CanvasSize = UDim2.new(0, 0, 0, canvasY)
end


Players.PlayerAdded:Connect(function(p) setupESP(p); if isEnabled then refreshPlayerList() end end)
Players.PlayerRemoving:Connect(function(p) removeESP(p); if isEnabled then task.wait(); refreshPlayerList() end end)
for _, p in pairs(Players:GetPlayers()) do setupESP(p) end

local coreLoop = RunService.RenderStepped:Connect(function()
    for _, player in pairs(Players:GetPlayers()) do
        local char = player.Character
        local monitorLabel = monitorItems[player]
        
        -- [1] 更新左下角監控清單 (Live Health Update)
        if isEnabled and monitorLabel and char and char:FindFirstChild("Humanoid") then
            local hum = char.Humanoid
            monitorLabel.Text = string.format("HP: %d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth))
            monitorLabel.TextColor3 = Color3.fromHSV((hum.Health / hum.MaxHealth) * 0.35, 0.9, 1)
        end

        -- [2] 更新 3D 骨架渲染
        if isDrawingSupported and espCache[player] then
            local data = espCache[player]
            if not isEnabled or not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                for _, l in pairs(data.lines) do l.Visible = false end
                continue
            end

            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local _, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    -- 骨架智能連接點遍歷
                    for i, joint in ipairs(data.joints) do
                        local p1, p2 = char:FindFirstChild(joint[1]), char:FindFirstChild(joint[2])
                        if p1 and p2 then
                            local pos1, vis1 = Camera:WorldToViewportPoint(p1.Position)
                            local pos2, vis2 = Camera:WorldToViewportPoint(p2.Position)
                            data.lines[i].From = Vector2.new(pos1.X, pos1.Y)
                            data.lines[i].To = Vector2.new(pos2.X, pos2.Y)
                            data.lines[i].Visible = vis1 or vis2
                        else
                            data.lines[i].Visible = false
                        end
                    end
                else
                    for _, l in pairs(data.lines) do l.Visible = false end
                end
            end
        end
    end
end)


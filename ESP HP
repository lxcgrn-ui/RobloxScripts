--[[ 
    HVXZ TEAM - FULL RED WALLHACK & PLAYER MONITOR
    Platform: PC & Mobile (Universal)
    Visuals: Skeleton + Box + Red Highlight (Chams)
    Data: Bottom-Left List (Name + HP Numbers)
    Logic: Instant Refresh, No Animations
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- Check Drawing Support
local isDrawingSupported = pcall(function() return Drawing.new("Line") end)

local function cleanup()
    local oldGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("HVXZ_MONITOR_ESP")
    if oldGui then oldGui:Destroy() end
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            if p.Character:FindFirstChild("HVXZ_ESP_TAG") then p.Character.HVXZ_ESP_TAG:Destroy() end
            if p.Character:FindFirstChild("HVXZ_ESP_BOX") then p.Character.HVXZ_ESP_BOX:Destroy() end
            if p.Character:FindFirstChild("HVXZ_ESP_CHAMS") then p.Character.HVXZ_ESP_CHAMS:Destroy() end
        end
    end
end
cleanup()

local gui = Instance.new("ScreenGui")
gui.Name = "HVXZ_MONITOR_ESP"; gui.ResetOnSpawn = false; gui.IgnoreGuiInset = true; gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local Config = { 
    MainRed = Color3.fromRGB(255, 0, 0),
    Glass = Color3.fromRGB(10, 10, 10),
    Trans = 0.5,
    White = Color3.fromRGB(255, 255, 255)
}
local isEnabled = false
local listItems = {} -- Cache for health labels

-- UI: Bottom Left Player List
local ListFrame = Instance.new("Frame", gui)
ListFrame.Size = UDim2.new(0, 180, 0, 250); ListFrame.Position = UDim2.new(0, 20, 1, -20); ListFrame.AnchorPoint = Vector2.new(0, 1)
ListFrame.BackgroundColor3 = Config.Glass; ListFrame.BackgroundTransparency = Config.Trans; ListFrame.Visible = false
Instance.new("UICorner", ListFrame).CornerRadius = UDim.new(0, 8); Instance.new("UIStroke", ListFrame).Color = Config.MainRed

local ListTitle = Instance.new("TextLabel", ListFrame)
ListTitle.Size = UDim2.new(1, 0, 0, 30); ListTitle.BackgroundTransparency = 1; ListTitle.Text = "  PLAYER MONITOR"
ListTitle.TextColor3 = Config.MainRed; ListTitle.Font = Enum.Font.GothamBold; ListTitle.TextSize = 12; ListTitle.TextXAlignment = Enum.TextXAlignment.Left

local ListScroll = Instance.new("ScrollingFrame", ListFrame)
ListScroll.Size = UDim2.new(1, -10, 1, -40); ListScroll.Position = UDim2.new(0, 5, 0, 35); ListScroll.BackgroundTransparency = 1
ListScroll.ScrollBarThickness = 2; ListScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
Instance.new("UIListLayout", ListScroll).Padding = UDim.new(0, 5)

local function refreshList()
    for _, child in pairs(ListScroll:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
    listItems = {}
    local totalY = 0
    for _, p in pairs(Players:GetPlayers()) do
        local item = Instance.new("Frame", ListScroll)
        item.Size = UDim2.new(1, -5, 0, 32); item.BackgroundColor3 = Color3.fromRGB(30,0,0); item.BackgroundTransparency = 0.6
        Instance.new("UICorner", item).CornerRadius = UDim.new(0, 4)

        local nLabel = Instance.new("TextLabel", item)
        nLabel.Size = UDim2.new(1, -10, 0, 16); nLabel.Position = UDim2.new(0, 5, 0, 2); nLabel.BackgroundTransparency = 1
        nLabel.Text = p.Name; nLabel.TextColor3 = Config.White; nLabel.Font = Enum.Font.GothamBold; nLabel.TextSize = 11; nLabel.TextXAlignment = Enum.TextXAlignment.Left

        local hLabel = Instance.new("TextLabel", item)
        hLabel.Size = UDim2.new(1, -10, 0, 14); hLabel.Position = UDim2.new(0, 5, 0, 16); hLabel.BackgroundTransparency = 1
        hLabel.Text = "HP: 100"; hLabel.TextColor3 = Config.MainRed; hLabel.Font = Enum.Font.Gotham; hLabel.TextSize = 10; hLabel.TextXAlignment = Enum.TextXAlignment.Left

        listItems[p] = hLabel
        totalY = totalY + 37
    end
    ListScroll.CanvasSize = UDim2.new(0, 0, 0, totalY)
end

Players.PlayerAdded:Connect(function() if isEnabled then task.wait(); refreshList() end end)
Players.PlayerRemoving:Connect(function() if isEnabled then task.wait(); refreshList() end end)

-- Main Toggle UI
local Main = Instance.new("Frame", gui)
Main.Size = UDim2.new(0, 220, 0, 100); Main.Position = UDim2.new(0.5, 0, 0.5, 0); Main.AnchorPoint = Vector2.new(0.5, 0.5); Main.BackgroundColor3 = Config.Glass
Instance.new("UICorner", Main); Instance.new("UIStroke", Main).Color = Config.MainRed

local TBtn = Instance.new("TextButton", Main)
TBtn.Size = UDim2.new(1, -20, 0, 40); TBtn.Position = UDim2.new(0, 10, 0, 45); TBtn.BackgroundColor3 = Color3.fromRGB(30,0,0); TBtn.Text = "ACTIVATE FULL ESP"; TBtn.TextColor3 = Config.White; TBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", TBtn)

TBtn.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    TBtn.Text = isEnabled and "DEACTIVATE" or "ACTIVATE FULL ESP"
    ListFrame.Visible = isEnabled
    if isEnabled then refreshList() else cleanup() end
end)

-- ESP System Logic
local espCache = {}

local function applyChams(char)
    local highlight = Instance.new("Highlight", char)
    highlight.Name = "HVXZ_ESP_CHAMS"
    highlight.FillColor = Config.MainRed
    highlight.OutlineColor = Config.White
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
end

local function setupESP(player)
    if player == LocalPlayer then return end
    if isDrawingSupported then
        local lines = {}; local joints = {{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"}}
        for _ = 1, #joints do
            local l = Drawing.new("Line"); l.Visible = false; l.Color = Config.MainRed; l.Thickness = 1.5; table.insert(lines, l)
        end
        local box = Drawing.new("Square"); box.Visible = false; box.Color = Config.MainRed; box.Thickness = 1.5; box.Filled = false
        espCache[player] = {lines = lines, box = box, joints = joints}
    end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        if isEnabled then applyChams(char) end
    end)
    if player.Character then applyChams(player.Character) end
end

local function removeESP(player)
    if espCache[player] then
        if isDrawingSupported then
            for _, l in pairs(espCache[player].lines) do l:Remove() end
            espCache[player].box:Remove()
        end
        espCache[player] = nil
    end
end

Players.PlayerAdded:Connect(setupESP)
Players.PlayerRemoving:Connect(removeESP)
for _, p in pairs(Players:GetPlayers()) do setupESP(p) end

RunService.RenderStepped:Connect(function()
    if not isEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        local char = player.Character
        local hLabel = listItems[player]
        
        -- Update Health in List
        if hLabel and char and char:FindFirstChild("Humanoid") then
            hLabel.Text = "HP: " .. math.floor(char.Humanoid.Health)
        end

        -- Update 3D Visuals
        if isDrawingSupported and espCache[player] then
            local data = espCache[player]
            if not char or not char:FindFirstChild("HumanoidRootPart") or char.Humanoid.Health <= 0 then
                for _, l in pairs(data.lines) do l.Visible = false end
                data.box.Visible = false; continue
            end
            
            local hrp = char.HumanoidRootPart
            local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                -- Box
                local size = Vector2.new(Camera.ViewportSize.X * (2 / hrpPos.Z), Camera.ViewportSize.X * (3.5 / hrpPos.Z))
                data.box.Size = size; data.box.Position = Vector2.new(hrpPos.X - size.X / 2, hrpPos.Y - size.Y / 2)
                data.box.Visible = true
                -- Skeleton
                for i, joint in ipairs(data.joints) do
                    local p1, p2 = char:FindFirstChild(joint[1]), char:FindFirstChild(joint[2])
                    if p1 and p2 then
                        local pos1, vis1 = Camera:WorldToViewportPoint(p1.Position)
                        local pos2, vis2 = Camera:WorldToViewportPoint(p2.Position)
                        data.lines[i].From = Vector2.new(pos1.X, pos1.Y); data.lines[i].To = Vector2.new(pos2.X, pos2.Y); data.lines[i].Visible = vis1 or vis2
                    end
                end
            else
                data.box.Visible = false
                for _, l in pairs(data.lines) do l.Visible = false end
            end
        end
    end
end)

local function refreshPlayerList()
    if not isEnabled then return end
    for _, child in pairs(PLScroll:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
    monitorItems = {}
    local ySize = 0
    
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        
        local pFrame = Instance.new("Frame", PLScroll)
        pFrame.Size = UDim2.new(1, -5, 0, 32); pFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30); pFrame.BackgroundTransparency = 0.5
        Instance.new("UICorner", pFrame).CornerRadius = UDim.new(0, 6)

        local pName = Instance.new("TextLabel", pFrame)
        pName.Size = UDim2.new(1, -10, 0, 16); pName.Position = UDim2.new(0, 8, 0, 2); pName.BackgroundTransparency = 1
        pName.TextColor3 = Config.Text; pName.Font = Enum.Font.GothamBold; pName.TextSize = 11; pName.TextXAlignment = Enum.TextXAlignment.Left
        
        local pHPLabel = Instance.new("TextLabel", pFrame)
        pHPLabel.Size = UDim2.new(1, -10, 0, 12); pHPLabel.Position = UDim2.new(0, 8, 0, 16); pHPLabel.BackgroundTransparency = 1
        pHPLabel.TextColor3 = Config.Red; pHPLabel.Font = Enum.Font.Gotham; pHPLabel.TextSize = 10; pHPLabel.TextXAlignment = Enum.TextXAlignment.Left
        
        task.spawn(function()
            local isFriend = friendCache[p.UserId]
            if isFriend == nil then isFriend = LocalPlayer:IsFriendsWith(p.UserId); friendCache[p.UserId] = isFriend end
            if isFriend then pName.Text = p.Name .. " [⭐ FRIEND]"; pName.TextColor3 = Config.Green else pName.Text = p.Name end
        end)

        monitorItems[p] = pHPLabel
        ySize = ySize + 36
    end
    PLScroll.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

-- ================================================================================
-- [SECTION 5] FULL SKELETON ENGINE (R6 & R15 HYBRID)
-- ================================================================================
local function setupESP(player)
    if player == LocalPlayer or not isDrawingSupported then return end
    
    local lines = {}
    -- 定義所有可能的骨骼連接點
    local joints = {
        -- R15 / R6 通用核心
        {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"}, 
        -- R15 專用細節
        {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
        -- R6 備用連接點 (當識別為 R6 時使用)
        {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"}, 
        {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
    }
    
    -- 預先創建 Line 物件以優化性能
    for _ = 1, #joints do
        local l = Drawing.new("Line")
        l.Visible = false; l.Color = Config.Bone; l.Thickness = Config.Thickness; l.Transparency = 1
        table.insert(lines, l)
    end
    espCache[player] = {lines = lines, joints = joints}
end

local function removeESP(player)
    if espCache[player] then
        for _, l in pairs(espCache[player].lines) do l:Remove() end
        espCache[player] = nil
    end
    monitorItems[player] = nil
end


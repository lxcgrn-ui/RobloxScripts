    btn.BackgroundColor3 = theme
    stroke.Color = theme
    notify(isEnabled and "SKELETON: ON" or "SKELETON: OFF", isEnabled)
end)

-- 5. DRAWING SKELETON & HEALTH LOGIC
local espCache = {}

local function getLine()
    local line = Drawing.new("Line")
    line.Visible = false
    line.Color = Config.BoneColor
    line.Thickness = Config.Thickness
    line.Transparency = 1
    return line
end

local function createESP(player)
    if player == LocalPlayer then return end

    local lines = {}
    -- Standard R15 Joints
    local joints = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}
    }
    for _ = 1, #joints do table.insert(lines, getLine()) end

    local healthText = Drawing.new("Text")
    healthText.Visible = false
    healthText.Center = true
    healthText.Outline = true
    healthText.Size = 14
    healthText.Font = 2
    healthText.Color = Color3.fromRGB(255, 255, 255)

    espCache[player] = {lines = lines, text = healthText, joints = joints}
end

local function removeESP(player)
    if espCache[player] then
        for _, line in pairs(espCache[player].lines) do line:Remove() end
        espCache[player].text:Remove()
        espCache[player] = nil
    end
end

Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)
for _, p in pairs(Players:GetPlayers()) do createESP(p) end

-- 6. MAIN RENDER LOOP (Zero Lag)
RunService.RenderStepped:Connect(function()
    for player, cache in pairs(espCache) do
        local lines = cache.lines
        local hText = cache.text
        local joints = cache.joints
        
        local char = player.Character
        if not isEnabled or not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
            for _, line in pairs(lines) do line.Visible = false end
            hText.Visible = false
            continue
        end

        local hrp = char.HumanoidRootPart
        local hum = char.Humanoid
        local head = char:FindFirstChild("Head")
        
        local _, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        
        if onScreen then
            -- Position Health Text Above Head
            if head then
                local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                hText.Position = Vector2.new(headPos.X, headPos.Y)
                hText.Text = string.format("%.1f%%", hp * 100)
                hText.Color = Color3.fromHSV(hp * 0.35, 0.8, 1)
                hText.Visible = true
            else
                hText.Visible = false
            end

            -- Draw Skeleton Lines
            for i, joint in ipairs(joints) do
                local partA = char:FindFirstChild(joint[1])
                local partB = char:FindFirstChild(joint[2])
                
                if partA and partB then
                    local posA, visA = Camera:WorldToViewportPoint(partA.Position)
                    local posB, visB = Camera:WorldToViewportPoint(partB.Position)
                    
                    if visA or visB then
                        lines[i].From = Vector2.new(posA.X, posA.Y)
                        lines[i].To = Vector2.new(posB.X, posB.Y)
                        lines[i].Visible = true
                    else
                        lines[i].Visible = false
                    end
                else
                    lines[i].Visible = false
                end
            end
        else
            hText.Visible = false
            for _, line in pairs(lines) do line.Visible = false end
        end
    end
end)

-- Safe Cleanup on Script Re-execution
gui.Destroying:Connect(function()
    for p, _ in pairs(espCache) do removeESP(p) end
end)

notify("HVXZ SKELETON READY", true)

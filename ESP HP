ToggleBtn.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    local c = isEnabled and Config.Cyan or Config.Red
    TweenService:Create(TStroke, TweenInfo.new(0.3), {Color = c}):Play()

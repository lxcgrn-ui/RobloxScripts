-- ESP & Chams Logic
local function applyChams(char)
    if not char:FindFirstChild("HVXZ_CHAMS") then
        local highlight = Instance.new("Highlight", char)
        highlight.Name = "HVXZ_CHAMS"; highlight.FillColor = Config.Red; highlight.OutlineColor = Config.White; highlight.FillTransparency = 0.5; highlight.OutlineTransparency = 0
    end
end

local espCache = {}
local function setupESP(player)
    if player == LocalPlayer then return end
    if isDrawingSupported then
        local lines = {}; local joints = {{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"}}
        for _ = 1, #joints do
            local l = Drawing.new("Line"); l.Visible = false; l.Color = Config.Red; l.Thickness = 1.5; table.insert(lines, l)
        end
        local box = Drawing.new("Square"); box.Visible = false; box.Color = Config.Red; box.Thickness = 1.5; box.Filled = false
        espCache[player] = {lines = lines, box = box, joints = joints}
    end
    player.CharacterAdded:Connect(function(char) task.wait(0.5); if isEnabled then applyChams(char) end end)
    if player.Character then applyChams(player.Character) end
end

Players.PlayerAdded:Connect(function(p) setupESP(p); if isEnabled then refreshMonitor() end end)
Players.PlayerRemoving:Connect(function(p) if espCache[p] then if isDrawingSupported then for _,l in pairs(espCache[p].lines) do l:Remove() end espCache[p].box:Remove() end espCache[p] = nil end; if isEnabled then refreshMonitor() end end)
for _, p in pairs(Players:GetPlayers()) do setupESP(p) end

-- Rendering Loop
RunService.RenderStepped:Connect(function()
    for _, player in pairs(Players:GetPlayers()) do
        local char = player.Character
        -- Update Monitor HP
        if isEnabled and listItems[player] and char and char:FindFirstChild("Humanoid") then
            listItems[player].Text = "HP: " .. math.floor(char.Humanoid.Health)
        end
        -- Update 3D Visuals
        if isDrawingSupported and espCache[player] then
            local data = espCache[player]
            if not isEnabled or not char or not char:FindFirstChild("HumanoidRootPart") or char.Humanoid.Health <= 0 then
                for _, l in pairs(data.lines) do l.Visible = false end; data.box.Visible = false; continue
            end
            local hrp = char.HumanoidRootPart
            local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local size = Vector2.new(Camera.ViewportSize.X * (2 / hrpPos.Z), Camera.ViewportSize.X * (3.5 / hrpPos.Z))
                data.box.Size = size; data.box.Position = Vector2.new(hrpPos.X - size.X / 2, hrpPos.Y - size.Y / 2); data.box.Visible = true
                for i, joint in ipairs(data.joints) do
                    local p1, p2 = char:FindFirstChild(joint[1]), char:FindFirstChild(joint[2])
                    if p1 and p2 then
                        local pos1, vis1 = Camera:WorldToViewportPoint(p1.Position); local pos2, vis2 = Camera:WorldToViewportPoint(p2.Position)
                        data.lines[i].From = Vector2.new(pos1.X, pos1.Y); data.lines[i].To = Vector2.new(pos2.X, pos2.Y); data.lines[i].Visible = vis1 or vis2
                    end
                end
            else
                for _, l in pairs(data.lines) do l.Visible = false end; data.box.Visible = false
            end
        end
    end
end)

-- ESP 核心 (相容模式)
local espCache = {}

local function createMobileESP(player)
    player.CharacterAdded:Connect(function(char)
        if not isDrawingSupported then
            local head = char:WaitForChild("Head", 10)
            if head then
                local bb = Instance.new("BillboardGui", char); bb.Name = "HVXZ_ESP_TAG"; bb.AlwaysOnTop = true
                bb.Size = UDim2.new(0, 100, 0, 50); bb.StudsOffset = Vector3.new(0, 3, 0)
                local tl = Instance.new("TextLabel", bb); tl.Size = UDim2.new(1, 0, 1, 0); tl.BackgroundTransparency = 1
                tl.TextColor3 = Config.Cyan; tl.Font = Enum.Font.GothamBold; tl.TextSize = 12; tl.TextStrokeTransparency = 0
            end
        end
    end)
end

local function setupESP(player)
    if player == LocalPlayer then return end
    if isDrawingSupported then
        -- PC Drawing 骨架
        local lines = {}; local joints = { {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"}, {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"} }
        for _ = 1, #joints do
            local l = Drawing.new("Line"); l.Visible = false; l.Color = Config.Bone; l.Thickness = 1.5; table.insert(lines, l)
        end
        local text = Drawing.new("Text"); text.Visible = false; text.Center = true; text.Outline = true; text.Size = 14; text.Font = 2
        espCache[player] = {lines = lines, text = text, joints = joints}
    else
        -- 手機 BillboardGui
        createMobileESP(player)
    end
end

local function removeESP(player)
    if espCache[player] then
        if isDrawingSupported then
            for _, l in pairs(espCache[player].lines) do l:Remove() end
            espCache[player].text:Remove()
        end
        espCache[player] = nil
    end
end

Players.PlayerAdded:Connect(setupESP)
Players.PlayerRemoving:Connect(removeESP)
for _, p in pairs(Players:GetPlayers()) do setupESP(p) end

local coreLoop = RunService.RenderStepped:Connect(function()
    for _, player in pairs(Players:GetPlayers()) do
        local char = player.Character
        if isDrawingSupported and espCache[player] then
            -- PC 渲染邏輯
            local data = espCache[player]
            if not isEnabled or not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                for _, l in pairs(data.lines) do l.Visible = false end
                data.text.Visible = false; continue
            end
            local hum, hrp, head = char.Humanoid, char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Head")
            if hrp and head then
                local _, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                    data.text.Position = Vector2.new(headPos.X, headPos.Y)
                    data.text.Text = string.format("%s [%d%%]", player.Name, (hum.Health/hum.MaxHealth)*100)
                    data.text.Color = Color3.fromHSV((hum.Health/hum.MaxHealth) * 0.35, 0.8, 1); data.text.Visible = true
                    for i, joint in ipairs(data.joints) do
                        local p1, p2 = char:FindFirstChild(joint[1]), char:FindFirstChild(joint[2])
                        if p1 and p2 then
                            local pos1, vis1 = Camera:WorldToViewportPoint(p1.Position)
                            local pos2, vis2 = Camera:WorldToViewportPoint(p2.Position)
                            data.lines[i].From = Vector2.new(pos1.X, pos1.Y); data.lines[i].To = Vector2.new(pos2.X, pos2.Y); data.lines[i].Visible = vis1 or vis2
                        end
                    end
                else data.text.Visible = false; for _, l in pairs(data.lines) do l.Visible = false end end
            end
        elseif not isDrawingSupported and char and char:FindFirstChild("HVXZ_ESP_TAG") then
            -- 手機 渲染邏輯
            local tag = char.HVXZ_ESP_TAG.TextLabel
            if isEnabled and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local hum = char.Humanoid
                tag.Visible = true
                tag.Text = string.format("%s\nHP: %d", player.Name, math.floor(hum.Health))
                tag.TextColor3 = Color3.fromHSV(math.clamp(hum.Health/100, 0, 0.35), 0.8, 1)
            else tag.Visible = false end
        end
    end
end)

gui.Destroying:Connect(function() 
    coreLoop:Disconnect()
    for p, _ in pairs(espCache) do removeESP(p) end
    cleanup()
end)

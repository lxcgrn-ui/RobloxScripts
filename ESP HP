-- Environment Detection: Drawing API Check
local isDrawingSupported = pcall(function() return Drawing.new("Line") end)

local function cleanup()
    local oldGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("HVXZ_HUB_ESP")
    if oldGui then oldGui:Destroy() end
    -- Cleanup Character Visuals
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            if p.Character:FindFirstChild("HVXZ_ESP_TAG") then p.Character.HVXZ_ESP_TAG:Destroy() end
            if p.Character:FindFirstChild("HVXZ_ESP_BOX") then p.Character.HVXZ_ESP_BOX:Destroy() end
            if p.Character:FindFirstChild("HVXZ_CHAMS") then p.Character.HVXZ_CHAMS:Destroy() end
        end
    end
end
cleanup()

local gui = Instance.new("ScreenGui")
gui.Name = "HVXZ_HUB_ESP"; gui.ResetOnSpawn = false; gui.IgnoreGuiInset = true; gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local Config = { 
    Glass = Color3.fromRGB(15,15,15), 
    Trans = 0.4, 
    Cyan = Color3.fromRGB(0,255,255), 
    Red = Color3.fromRGB(255,0,0), 
    White = Color3.fromRGB(255,255,255),
    Text = Color3.fromRGB(255,255,255)
}

local isEnabled = false
local listItems = {} -- Stores health labels for the monitor

-- Draggable Logic
local function makeDraggable(frame)
    local dragToggle, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragToggle = true; dragStart = input.Position; startPos = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragToggle then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    frame.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragToggle = false end end)
end

-- Monitor UI (Bottom Left)

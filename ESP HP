local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- 1. CLEANUP PREVIOUS VERSIONS
local function cleanup()
    local oldGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("HVXZ_Skeleton_UI")
    if oldGui then oldGui:Destroy() end
end
cleanup()

-- 2. CORE UI & CONFIG
local gui = Instance.new("ScreenGui")
gui.Name = "HVXZ_Skeleton_UI"
gui.ResetOnSpawn = false
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local isEnabled = true
local Config = {
    ActiveColor = Color3.fromRGB(0, 255, 255),
    InactiveColor = Color3.fromRGB(255, 50, 50),
    BoneColor = Color3.fromRGB(255, 255, 255),
    Thickness = 1.5
}

-- 3. YOUR NOTIFICATION SYSTEM
local function notify(msg, state)
    local color = state and Config.ActiveColor or Config.InactiveColor
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 220, 0, 45)
    label.Position = UDim2.new(1, 10, 1, -65)
    label.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    label.TextColor3 = color
    label.Font = Enum.Font.Code
    label.TextSize = 15
    label.Text = " " .. msg
    label.BackgroundTransparency = 0.2
    label.Parent = gui
    
    Instance.new("UICorner", label).CornerRadius = UDim.new(0, 8)
    
    label:TweenPosition(UDim2.new(1, -240, 1, -65), "Out", "Quart", 0.3, true)
    task.delay(2.5, function()
        label:TweenPosition(UDim2.new(1, 10, 1, -65), "In", "Quart", 0.3, true, function() label:Destroy() end)
    end)
end

-- 4. YOUR TOGGLE BUTTON
local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 50, 0, 50)
btn.Position = UDim2.new(0, 25, 0, 25)
btn.BackgroundColor3 = Config.ActiveColor
btn.Text = "HVXZ"
btn.Font = Enum.Font.GothamBold
btn.TextSize = 12
btn.TextColor3 = Color3.fromRGB(0, 0, 0)
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
local stroke = Instance.new("UIStroke", btn)
stroke.Thickness = 3
stroke.Color = Config.ActiveColor

btn.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled

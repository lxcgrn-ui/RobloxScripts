-- [[ SECTION 3: LOGGING ENGINE ]]
-- Custom logger to provide feedback in the executor console

local function HVXZ_LOG(message, level)
    if not HVXZ_CORE.SETTINGS.SECURITY.DEBUG_LOGGING then return end
    
    local timestamp = os.date("%H:%M:%S")
    local prefix = "[HVXZ-STEALTH][" .. timestamp .. "]"
    
    if level == "WARN" then
        warn(prefix .. " [!] " .. tostring(message))
    elseif level == "ERROR" then
        error(prefix .. " [X] " .. tostring(message))
    else
        print(prefix .. " [i] " .. tostring(message))
    end
end

-- [[ SECTION 4: UTILITY MODULES ]]
-- Reusable functions for safe instance handling

local Utils = {}

function Utils.SafeWait(parent, childName, timeout)
    local start = tick()
    while not parent:FindFirstChild(childName) do
        if tick() - start > (timeout or 5) then
            return nil
        end
        task.wait()
    end
    return parent[childName]
end

function Utils.ForceProperty(instance, property, value)
    local success, err = pcall(function()
        instance[property] = value
    end)
    return success, err
end

-- [[ SECTION 5: VISUAL SUPPRESSION ENGINE ]]
-- The core logic for making the character invisible while keeping physics alive

local StealthEngine = {}

-- Handles the actual transparency logic for any part passed into it
function StealthEngine:ProcessInstance(instance)
    if not instance then return end

    -- Handle standard body parts and accessories
    if instance:IsA("BasePart") then
        instance.Transparency = HVXZ_CORE.SETTINGS.STEALTH.GLOBAL_TRANSPARENCY
        instance.CastShadow = not HVXZ_CORE.SETTINGS.STEALTH.SHADOW_SUPPRESSION
        
        -- Logic for collision: RootPart MUST collide, others can be disabled for performance
        if instance.Name == "HumanoidRootPart" then
            instance.CanCollide = true
        else
            -- We set CanCollide to false for limbs to prevent "getting stuck" on small objects
            instance.CanCollide = false
        end
    end

    -- Handle Face Decals and Textures
    if instance:IsA("Decal") or instance:IsA("Texture") then
        if HVXZ_CORE.SETTINGS.STEALTH.HIDE_ALL_DECALS then
            instance.Transparency = HVXZ_CORE.SETTINGS.STEALTH.GLOBAL_TRANSPARENCY
        end
    end

    -- Handle Name Tags and Health Bars
    if instance:IsA("BillboardGui") or instance:IsA("SurfaceGui") or instance:IsA("Adornment") then
        if HVXZ_CORE.SETTINGS.STEALTH.HIDE_UI_ADORNMENTS then
            instance.Enabled = false
        end
    end

    -- Special handling for Accessories (Hats, Back Items)
    if instance:IsA("Accessory") then
        local handle = instance:FindFirstChild("Handle")
        if handle then
            handle.Transparency = HVXZ_CORE.SETTINGS.STEALTH.GLOBAL_TRANSPARENCY
            handle.CastShadow = false
            handle.CanCollide = false
        end
    end
end

-- Iterates through the entire character model
function StealthEngine:FullPurge(character)
    HVXZ_LOG("Commencing full visual purge of character...")
    
    for _, child in pairs(character:GetDescendants()) do
        self:ProcessInstance(child)
    end
    
    -- Ensure names are hidden via Humanoid settings
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        humanoid.NameDisplayDistance = 0
    end
end

-- [[ SECTION 6: PHYSICS & VELOCITY ENGINE ]]
-- Handles the 500+ speed and ground-based interaction

local PhysicsEngine = {}

function PhysicsEngine:ApplyVelocity(humanoid)
    if not humanoid then return end
    
    humanoid.WalkSpeed = HVXZ_CORE.SETTINGS.MOVEMENT.WALK_SPEED
    humanoid.JumpPower = HVXZ_CORE.SETTINGS.MOVEMENT.JUMP_POWER
    
    -- Using RunService to "Force" the speed every frame
    -- This bypasses some game-specific scripts that try to reset your speed
    local loop = RunService.Heartbeat:Connect(function()
        if humanoid and humanoid.Parent then
            humanoid.WalkSpeed = HVXZ_CORE.SETTINGS.MOVEMENT.WALK_SPEED
        end
    end)
    
    table.insert(HVXZ_CORE.CONNECTIONS, loop)
end

-- [[ SECTION 7: EVENT LISTENER MODULE ]]
-- Ensures that tools and new items become invisible instantly

local EventManager = {}

function EventManager:Bind(character)
    -- Watch for items added to character (like tools being equipped)
    local childAdded = character.ChildAdded:Connect(function(child)
        task.wait() -- Minimal delay for item loading
        if child:IsA("Tool") then
            HVXZ_LOG("Tool detected: " .. child.Name .. ". Applying ghosting protocol.")
            for _, p in pairs(child:GetDescendants()) do
                StealthEngine:ProcessInstance(p)
            end
        else
            StealthEngine:ProcessInstance(child)
        end
    end)
    
    -- Watch for specific parts being added deeper in the hierarchy
    local descAdded = character.DescendantAdded:Connect(function(desc)
        task.wait()
        StealthEngine:ProcessInstance(desc)
    end)
    
    table.insert(HVXZ_CORE.CONNECTIONS, childAdded)
    table.insert(HVXZ_CORE.CONNECTIONS, descAdded)
end

-- [[ SECTION 8: CORE EXECUTION CONTROLLER ]]
-- Manages the lifecycle of the script

function HVXZ_CORE:Execute()
    HVXZ_LOG("HVXZ System Booting. Target Version: " .. self.VERSION)
    
    -- 1. Locate Character
    self.CHARACTER = self.LOCAL_PLAYER.Character or self.LOCAL_PLAYER.CharacterAdded:Wait()
    self.HUMANOID = self.CHARACTER:WaitForChild("Humanoid")
    self.ROOT_PART = self.CHARACTER:WaitForChild("HumanoidRootPart")
    
    -- 2. Execute Engines
    StealthEngine:FullPurge(self.CHARACTER)
    PhysicsEngine:ApplyVelocity(self.HUMANOID)
    EventManager:Bind(self.CHARACTER)
    
    HVXZ_LOG("All protocols successfully deployed.")
    HVXZ_CORE.STATUS = "ACTIVE"
end

-- Cleanup function to prevent lag when re-running
function HVXZ_CORE:Teardown()
    HVXZ_LOG("Cleaning up previous session connections...")
    for _, conn in pairs(self.CONNECTIONS) do
        if conn then conn:Disconnect() end
    end
    self.CONNECTIONS = {}
end

-- [[ SECTION 9: AUTO-REDEPLOYMENT LOGIC ]]
-- Monitors for respawning

if HVXZ_CORE.SETTINGS.SECURITY.REBIND_ON_DEATH then
    HVXZ_CORE.LOCAL_PLAYER.CharacterAdded:Connect(function(newChar)
        HVXZ_LOG("Character respawn detected. Re-applying suite...")
        HVXZ_CORE:Teardown()
        task.wait(HVXZ_CORE.SETTINGS.SECURITY.EXECUTION_DELAY)
        HVXZ_CORE:Execute()
    end)
end

-- [[ SECTION 10: SCRIPT TECHNICAL DOCUMENTATION ]]
-- ==============================================================================
-- TECHNICAL OPERATION MANUAL:
--
-- 1. PHYSICS INTERACTION:
--    The script intentionally leaves 'HumanoidRootPart.Transparency' at 1, but
--    maintains its 'CanCollide' property. This is the secret to moving on the 
--    ground at 500 speed. If you were to set everything to CanCollide = false,
--    the physics engine would drop you into the void.
--
-- 2. INVISIBILITY METHODOLOGY:
--    By using 'Transparency = 1' rather than 'Transparency = 0.99', we achieve
--    true invisibility. Some older bypasses suggest 0.99, but with the 
--    'CastShadow = false' flag, 1.0 is safer and perfectly invisible.
--
-- 3. SPEED STABILIZATION:
--    At 500 speed, the 'Humanoid' object often triggers 'Auto-Jump' or 
--    'Clipping'. We utilize the 'RunService.Heartbeat' loop to ensure the 
--    WalkSpeed property is overwritten before the frame renders.
--
-- 4. PLAYER LIST PERSISTENCE:
--    This script modifies the character's appearance in the workspace. It does
--    not touch the 'Player' instance properties that the server uses to populate
--    the Leaderboard (Tab Menu). Thus, you remain visible on the list.
--
-- 5. ITEM COLLECTION:
--    The 'EventManager' module listens for 'ChildAdded'. When your character
--    touches a tool or a coin that enters your inventory/character model, 
--    the script instantly detects it and applies 'Transparency = 1'.
--
-- 6. TROUBLESHOOTING:
--    If you are moving too fast and fly off the map, decrease WALK_SPEED in 
--    the SECTION 2 configuration to 300 or 400.
-- ==============================================================================


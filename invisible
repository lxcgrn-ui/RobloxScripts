-- [SECTION 3: STATE MANAGEMENT]
local LocalPlayer = Players.LocalPlayer
local CurrentCharacter = nil
local CurrentHumanoid = nil
local Connections = {}

-- [SECTION 4: UTILITY FUNCTIONS]
-- Detailed logging for the executor console
local function HVXZ_Log(msg)
    if HVXZ_SETTINGS.SYSTEM.DEBUG_MODE then
        print("[HVXZ-DEBUG]: " .. tostring(msg))
    end
end

-- Safely wait for specific children
local function SafeWait(parent, childName, timeout)
    local timer = 0
    while not parent:FindFirstChild(childName) and timer < (timeout or 5) do
        timer = timer + task.wait()
    end
    return parent:FindFirstChild(childName)
end

-- [SECTION 5: STEALTH ENGINE - THE CORE LOGIC]

-- Function to handle individual part suppression
local function SuppressVisuals(part)
    if not part then return end

    -- Handle Physical Parts
    if part:IsA("BasePart") then
        -- We MUST keep the HumanoidRootPart visible to the physics engine
        -- but invisible to the player's eyes.
        part.Transparency = HVXZ_SETTINGS.STEALTH.FORCE_TRANSPARENCY
        part.CastShadow = HVXZ_SETTINGS.STEALTH.CAST_SHADOWS
        
        -- Physics preservation: Only RootPart should handle major collisions
        if part.Name ~= "HumanoidRootPart" then
            part.CanCollide = false
        else
            part.CanCollide = true
        end
    end

    -- Handle Decals (Faces, Clothing)
    if part:IsA("Decal") or part:IsA("Texture") then
        part.Transparency = HVXZ_SETTINGS.STEALTH.FORCE_TRANSPARENCY
    end

    -- Handle UI (Names, Health Bars)
    if part:IsA("BillboardGui") or part:IsA("SurfaceGui") then
        part.Enabled = false
    end

    -- Handle Accessories (Hats, Capes)
    if part:IsA("Accessory") then
        local handle = part:FindFirstChild("Handle")
        if handle then
            handle.Transparency = HVXZ_SETTINGS.STEALTH.FORCE_TRANSPARENCY
            handle.CastShadow = false
        end
    end
    
    -- Handle Tools
    if part:IsA("Tool") then
        for _, toolPart in pairs(part:GetDescendants()) do
            if toolPart:IsA("BasePart") then
                toolPart.Transparency = HVXZ_SETTINGS.STEALTH.FORCE_TRANSPARENCY
            end
        end
    end
end

-- [SECTION 6: HUMANID BEHAVIOR MODIFICATION]
local function ModifyHumanoid(humanoid)
    if not humanoid then return end
    
    -- Speed and Jump settings
    humanoid.WalkSpeed = HVXZ_SETTINGS.STRENGTH.WALK_SPEED
    humanoid.JumpPower = HVXZ_SETTINGS.STRENGTH.JUMP_POWER
    
    -- Display Name Suppression (Server-Side remains, Client-Side disappears)
    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
    humanoid.NameDisplayDistance = 0
    
    HVXZ_Log("Humanoid parameters successfully injected.")
end

-- [SECTION 7: THE RECURSIVE OBSERVER]
-- This ensures that anything added to the character later (like a sword or hat) becomes invisible instantly.
local function StartObserver(character)
    -- Initial cleaning
    for _, item in pairs(character:GetDescendants()) do
        SuppressVisuals(item)
    end

    -- Dynamic cleaning
    table.insert(Connections, character.DescendantAdded:Connect(function(descendant)
        task.wait() -- Allow instance to initialize
        SuppressVisuals(descendant)
    end))
    
    -- Specialized Tool Observer
    table.insert(Connections, character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            task.wait(0.05)
            SuppressVisuals(child)
        end
    end))
end

-- [SECTION 8: PHYSICS STABILIZATION]
-- Prevents the character from glitching or falling through floors at 500 speed.
local function StabilizePhysics(character)
    local hrp = character:WaitForChild("HumanoidRootPart")
    
    -- We use a BodyVelocity or Force if the speed is too high to prevent rubber-banding
    -- But for standard 500 speed, direct WalkSpeed is usually sufficient in modern executors.
    RunService.Stepped:Connect(function()
        if character and character:FindFirstChild("Humanoid") then
            character.Humanoid.WalkSpeed = HVXZ_SETTINGS.STRENGTH.WALK_SPEED
        end
    end)
end

-- [SECTION 9: INITIALIZATION WRAPPER]
local function InitializeHVXZ()
    HVXZ_Log("Initializing Stealth Protocol...")
    
    -- Clear previous connections to prevent memory leaks
    for _, conn in pairs(Connections) do
        if conn then conn:Disconnect() end
    end
    Connections = {}

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    CurrentCharacter = character
    CurrentHumanoid = humanoid
    
    -- Execute Core Modules
    ModifyHumanoid(humanoid)
    StartObserver(character)
    StabilizePhysics(character)
    
    HVXZ_Log("Stealth Protocol Fully Loaded.")
end

-- [SECTION 10: AUTO-RESPAWN LOGIC]
if HVXZ_SETTINGS.SYSTEM.AUTO_RESPAWN_REBIND then
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(HVXZ_SETTINGS.SYSTEM.EXECUTION_DELAY)
        InitializeHVXZ()
    end)
end

-- [SECTION 11: EXECUTION]
task.spawn(function()
    pcall(InitializeHVXZ)
end)


local function CleanupGhosts()
    if FakeCharacter then
        FakeCharacter:Destroy()
        FakeCharacter = nil
    end
    if HeartbeatConnection then
        HeartbeatConnection:Disconnect()
        HeartbeatConnection = nil
    end
    if RenderSteppedConnection then

        RenderSteppedConnection = nil
    end
end

local function BecomeVisible()
    if not InvisibleState then return end
    InvisibleState = false
    
    CleanupGhosts()
    
    if RealCharacter and RealCharacter:FindFirstChild("Humanoid") then
        Camera.CameraSubject = RealCharacter:FindFirstChild("Humanoid")
    end
    
    -- Static UI Update (No Animations)
    StatusLabel.Text = "Status: VISIBLE"
    StatusLabel.TextColor3 = Config.Colors.TextDim
    ToggleButton.Text = "ENABLE INVISIBLE"
    ToggleButton.BackgroundColor3 = Config.Colors.ButtonOff
    ToggleButton.BorderColor3 = Config.Colors.Border
end

local function BecomeInvisible()
    if InvisibleState then return end
    
    RealCharacter = LocalPlayer.Character
    if not RealCharacter then return end
    
    RealRootPart = RealCharacter:FindFirstChild("HumanoidRootPart")
    if not RealRootPart then return end
    
    local realHumanoid = RealCharacter:FindFirstChild("Humanoid")
    if not realHumanoid then return end
    
    InvisibleState = true
    
    -- Clone the character
    FakeCharacter = Utils.CloneCharacter(RealCharacter)
    FakeRootPart = FakeCharacter:FindFirstChild("HumanoidRootPart")
    local fakeHumanoid = FakeCharacter:FindFirstChild("Humanoid")
    
    -- Setup the Ghost Character
    FakeCharacter.Parent = Workspace
    FakeCharacter:SetPrimaryPartCFrame(RealRootPart.CFrame)
    
    -- Strip server-sided scripts from the clone to prevent double execution errors
    for _, obj in ipairs(FakeCharacter:GetDescendants()) do
        if obj:IsA("Script") then
            obj.Disabled = true
        end
    end
    
    -- Force Camera to the fake character
    Camera.CameraSubject = fakeHumanoid
    
    -- Lock Real Character Properties
    for _, part in ipairs(RealCharacter:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = 1
            part.CanCollide = false
            if part.Name == "HumanoidRootPart" then
                part.CanCollide = true -- Required for physics
            end
        elseif part:IsA("Decal") or part:IsA("Texture") then
            part.Transparency = 1
        end
    end
    
    -- Movement Sync Logic
    HeartbeatConnection = RunService.Heartbeat:Connect(function()
        if not InvisibleState or not RealCharacter or not FakeCharacter then return end
        
        -- Keep real character extremely far away
        if RealRootPart and FakeRootPart then
            RealRootPart.CFrame = FakeRootPart.CFrame + Config.OffsetVector
            RealRootPart.Velocity = Vector3.new(0, 0, 0)
            RealRootPart.RotVelocity = Vector3.new(0, 0, 0)
        end
    end)
    
    -- Animation and State Syncing
    RenderSteppedConnection = RunService.RenderStepped:Connect(function()
        if not InvisibleState or not RealCharacter or not FakeCharacter then return end
        
        if realHumanoid and fakeHumanoid then
            -- Mirror states to trick the server
            local moveDirection = fakeHumanoid.MoveDirection
            realHumanoid:Move(moveDirection, false)
            
            local jumpState = fakeHumanoid:GetState() == Enum.HumanoidStateType.Jumping
            if jumpState then
                realHumanoid.Jump = true
            end
        end
    end)
    
    -- Static UI Update (No Animations)
    StatusLabel.Text = "Status: INVISIBLE (GHOST)"
    StatusLabel.TextColor3 = Config.Colors.ButtonOn
    ToggleButton.Text = "DISABLE INVISIBLE"
    ToggleButton.BackgroundColor3 = Config.Colors.ButtonOff
    ToggleButton.BorderColor3 = Config.Colors.ButtonOn
end

